{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": "../dist-electron",
    "rootDir": ".",
    "allowImportingTsExtensions": false,
    "sourceMap": true
  },
  "include": ["main.cts", "preload.cts"]
}
