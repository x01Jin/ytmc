# Dependencies
node_modules/

# Build output (Vite -> dist/, esbuild -> dist/server.cjs)
dist/
build/
dist-ssr/
*.tsbuildinfo
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files — never commit real secrets; keep the example only
.env*
!.env.example

# Runtime data — YouTube session cookies, guest sessions, job state,
# library index, and app settings. NEVER commit: contains personal
# account cookies and local file paths.
data/
cookies.txt
*cookie*.txt
*.cookies

# Local conversion output — never commit (user's music files)
downloads/
*.mp3
*.m4a
*.flac
*.wav
*.opus
*.mp4
*.webm
*.mkv
*.part
*.ytdl

# Local binaries — bin/ holds 100MB+ ffmpeg/ffprobe builds, and GitHub
# rejects any file >= 100MB. Keep the dir ignored except the small
# extensionless yt-dlp launcher that fresh clones need to run.
bin/
!bin/yt-dlp
*.exe

# Python (yt-dlp plugins under plugins/) — never commit bytecode or venvs
__pycache__/
*.py[cod]
.venv/
venv/

# OS files
.DS_Store
Thumbs.db

# Editors / IDEs — share only the secret-free workspace settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temp, cache, test output
*.tmp
*.temp
.cache/
coverage/

# Single lockfile
bun.lock

# Private agent/dev context
AGENTS.md
context/
.ignore

# Electron desktop outputs (icon source files are committed)
dist-electron/
release/
assets/preview/
release-fixed/
