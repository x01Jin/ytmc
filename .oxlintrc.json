{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-debugger": "error"
  },
  "overrides": [
    {
      "files": ["src/main.tsx"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "node_modules/**"]
}
